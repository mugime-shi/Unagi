DATABASE_URL=postgresql://unagi:unagi@localhost:5432/unagi
ENTSOE_API_KEY=your-api-key-here
EUR_TO_SEK_RATE=11.0
DEBUG=true
# Web Push notifications — generate with: python scripts/gen_vapid_keys.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT=mailto:you@example.com
# Telegram Bot notifications — @BotFather でトークン取得, /getUpdates でchat_id確認
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cloudflare R2 — public forecast feed (empty = publishing disabled)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Per-area weather (scheduler only) — extra areas beyond SE3 to fetch daily
# from Open-Meteo. Backfill FIRST (./unagi backfill-weather --area SE1),
# then enable — partial coverage makes the loader prefer sparse local rows.
LOCAL_WEATHER_AREAS=
